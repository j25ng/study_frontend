generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://testuser:1234@localhost:3306/testdb"
}

model Account {
  account_id String @id
  owner_name String 
  balance Int
}

model Log {
  id Int @id @default(autoincrement())
  from_account_id String
  to_account_id String
  amount Int
  created_at DateTime @default(now())
}